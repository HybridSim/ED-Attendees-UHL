  <div class="layout">
    <div class="controls-wrap">
      <div class="controls">
        <div class="control col-span-3">
          <label>Growth style</label>
          <select id="growthStyle">
            <option value="exponential" selected>Exponential (default)</option>
            <option value="linear">Linear (absolute increment)</option>
