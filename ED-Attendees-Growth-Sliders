  </style>
</head>
<body>
  <header>
    <div class="brand">
      <img src="https://assets.zyrosite.com/AoP61N2BR4i8Q6jl/logo-hsml-AE07eKDgMLFgWBoQ.png" alt="MIDCARE / HSML Logo">
      <h1>UHL ED — Data‑fit 2014–2024 (clean K‑lines)</h1>
    </div>
    <div class="toolbar">
      <button id="run" class="btn">▶ Run</button>
      <button id="pause" class="btn" disabled>⏸ Pause</button>
      <button id="reset" class="btn">⟲ Reset</button>
      <span id="yearLabel" style="margin-left:6px;font-weight:600;">Year: 2014</span>
