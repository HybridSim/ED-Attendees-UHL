          <div class="val"><span id="surgeVal">60</span> trolleys</div>
        </div>
        <div class="control">
          <label>Cubicle capacity in <strong>2017</strong></label>
          <input id="capBase2017" type="range" min="0" max="300" step="1" value="49">
          <div class="val"><span id="capBase2017Val">49</span> cubicles</div>
        </div>
        <div class="control">
          <label>Capacity growth / yr</label>
          <input id="capInc" type="range" min="0" max="20" step="0.5" value="3">
          <div class="val"><span id="capIncVal">3.0</span> per yr</div>
        </div>

        <div class="control col-span-3">
          <label>Crisis shock</label>
          <div class="two-col">
            <div>
              <div class="small">Start year</div>
              <input id="shockStart" type="range" min="2015" max="2049" step="1" value="2020">
              <div class="val">Year <span id="shockStartVal">2020</span></div>
            </div>
            <div>
              <div class="small">Duration (years)</div>
              <input id="shockDur" type="range" min="0" max="5" step="1" value="2">
              <div class="val"><span id="shockDurVal">2</span> years</div>
            </div>
            <div>
              <div class="small">Attendee uplift (%)</div>
              <input id="shockU" type="range" min="0.00" max="0.50" step="0.01" value="0.10">
              <div class="val"><span id="shockUVal">10%</span></div>
            </div>
            <div>
              <div class="small">LOS uplift (%)</div>
              <input id="shockLOS" type="range" min="0.00" max="1.00" step="0.02" value="0.20">
              <div class="val"><span id="shockLOSVal">20%</span></div>
            </div>
          </div>
        </div>

        <div class="note col-span-3">
          <strong>Data:</strong> Historic ED attendees (2014–2024) from your table (2018 = 2017 × 1.0258 = 69,566). CSO pop implies ~0.6% pa trend. <strong>Vertical K‑lines</strong> show up to N milestones (K, 2K, 3K…).
        </div>
      </div>
    </div>

    <div class="plots">
      <div id="edPlot" class="plot"></div>
      <div id="trolleyPlot" class="plot"></div>
    </div>
  </div>

<script>
(function(){
  // Historic ED attendees (2014–2024) from user table. 2018 = 67,818 × 1.0258 ≈ 69,566.
  const YEARS_HIST = [2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024];
  const HIST_ED =   [55502,57297,64443,67818,69566,71315,65824,76473,79892,80113,87000];

  const YEARS_ALL = []; for(let y=2014;y<=2050;y++) YEARS_ALL.push(y);

  const $ = id => document.getElementById(id);
  const growth=$("growth"), growthVal=$("growthVal");
  const pop=$("pop"), popVal=$("popVal");
  const seasonU=$("seasonU"), seasonUVal=$("seasonUVal");
  const seasonM=$("seasonM"), seasonMVal=$("seasonMVal");
  const initial=$("initial"), initialVal=$("initialVal");
  const conv=$("conv"), convVal=$("convVal");
  const present=$("present"), presentVal=$("presentVal");
  const los=$("los"), losVal=$("losVal");
  const applyLOS=$("applyLOS");
  const capK=$("capK"), capKVal=$("capKVal");
  const kCount=$("kCount"), kCountVal=$("kCountVal");
  const capBase2017=$("capBase2017"), capBase2017Val=$("capBase2017Val");
  const capInc=$("capInc"), capIncVal=$("capIncVal");
  const surge=$("surge"), surgeVal=$("surgeVal");
  const growthStyle=$("growthStyle"), showAlt=$("showAlt");
  const yearLabel=$("yearLabel");
  const btnRun=$("run"), btnPause=$("pause"), btnReset=$("reset");

  const shockStart=$("shockStart"), shockStartVal=$("shockStartVal");
  const shockDur=$("shockDur"), shockDurVal=$("shockDurVal");
  const shockU=$("shockU"), shockUVal=$("shockUVal");
  const shockLOS=$("shockLOS"), shockLOSVal=$("shockLOSVal");

  const pct1 = v => (v*100).toFixed(1)+"%";
  const pct0 = v => (v*100).toFixed(0)+"%";
  const fmt = v => (+v).toLocaleString();

  function readParams(){
    return {
      r: parseFloat(growth.value),
      pop: parseFloat(pop.value),
      seasonU: parseFloat(seasonU.value),
      seasonM: parseFloat(seasonM.value),
      A0: parseFloat(initial.value),
      pConv: parseFloat(conv.value),
      pDay: parseFloat(present.value),
      LOS: parseFloat(los.value),
      useLOS: applyLOS.checked,
      K: parseFloat(capK.value),
      kCount: parseInt(kCount.value,10),
      capBase2017: parseFloat(capBase2017.value),
      capInc: parseFloat(capInc.value),
      surge: parseFloat(surge.value),
      mode: growthStyle.value,
      showAlt: showAlt.checked,
      shockStart: parseInt(shockStart.value,10),
      shockDur: parseInt(shockDur.value,10),
      shockU: parseFloat(shockU.value),
      shockLOS: parseFloat(shockLOS.value)
    };
  }

  function showVals(){
    const p=readParams();
    growthVal.textContent=pct1(p.r);
    popVal.textContent=pct1(p.pop);
    seasonUVal.textContent=pct1(p.seasonU);
    seasonMVal.textContent=p.seasonM.toFixed(0);
    initialVal.textContent=fmt(p.A0);
    convVal.textContent=pct1(p.pConv);
    presentVal.textContent=p.pDay.toFixed(0);
    losVal.textContent=p.LOS.toFixed(1);
    capKVal.textContent=fmt(p.K);
    kCountVal.textContent=p.kCount;
    capBase2017Val.textContent=p.capBase2017.toFixed(0);
    capIncVal.textContent=p.capInc.toFixed(1);
    surgeVal.textContent=p.surge.toFixed(0);
    shockStartVal.textContent=p.shockStart;
    shockDurVal.textContent=p.shockDur;
    shockUVal.textContent=pct0(p.shockU);
    shockLOSVal.textContent=pct0(p.shockLOS);
  }
  showVals();
  applyLOS.checked=false;

  function rEffective(p){
    const r_combined = (1+p.r)*(1+p.pop) - 1;
    const seasonal = 1 + p.seasonU * (p.seasonM/12);
    return (1+r_combined)*seasonal - 1;
  }

  function simulateModel(p, mode){
    const A=[p.A0];
    const rEff = rEffective(p);
    if(mode === "linear"){
      const g = p.A0 * rEff;
      for(let i=1;i<YEARS_ALL.length;i++){ A.push(A[i-1] + g); }
    } else if(mode === "logistic" && p.K>0){
      for(let i=1;i<YEARS_ALL.length;i++){
        const prev = A[i-1];
        const next = prev + rEff * prev * (1 - (prev / p.K));
        A.push(next);
      }
    } else {
      for(let i=1;i<YEARS_ALL.length;i++){ A.push(A[i-1]*(1+rEff)); }
    }
    if(p.shockDur>0){
      for(let i=0;i<YEARS_ALL.length;i++){
        const y = YEARS_ALL[i];
        if(y>=p.shockStart && y < p.shockStart + p.shockDur){
          A[i] = A[i] * (1 + p.shockU);
        }
      }
    }
    return A;
  }

  function computeAdmissions(ED, p){ return ED.map(v => v * p.pConv); }

  function computeTrolleys(p, ED){
    const T0 = p.pConv * p.pDay;            // initial (no LOS)
    const scale = ED.map(v => (ED[0] ? v/ED[0] : 1));
    let T = scale.map(f => T0 * f);
    if(p.useLOS){ T = T.map(v => v * p.LOS); }
    if(p.shockDur>0){
      T = T.map((v, i) => {
        const y = YEARS_ALL[i];
        if(p.useLOS && y>=p.shockStart && y < p.shockStart + p.shockDur){
          return v * (1 + p.shockLOS);
        }
        return v;
      });
    }
    return T;
  }
  function computeTrolleysNoLOS(p, ED){
    const T0 = p.pConv * p.pDay;
    const scale = ED.map(v => (ED[0] ? v/ED[0] : 1));
    return scale.map(f => T0 * f);
  }

  // Capacity: baseline 49 in 2017; growth per year; add fixed surge
  function computeCubicleCapacity(p){ return YEARS_ALL.map(y => Math.max(0, p.capBase2017 + p.capInc * (y - 2017))); }
  function computeTotalCapacity(p, cubicles){ return cubicles.map(v => v + p.surge); }

  function findKYearsLimited(ED, K, count){
    const years=[]; if(!K || K<=0 || !count) return years;
    let m=1, target=K;
    for(let i=0;i<ED.length && years.length<count;i++){
      if(ED[i] >= target){
        years.push(YEARS_ALL[i]);
        m++; target = K*m;
      }
    }
    return years;
  }

  function yRangeFrom(arr){
    const min=Math.min(...arr), max=Math.max(...arr);
    const pad=(max-min)*0.12 || 1;
    return [Math.max(0, Math.floor(min - pad)), Math.ceil(max + pad)];
  }

  function layoutED(range, kYears){
    const shapes=[], ann=[];
    kYears.forEach(yr=>{
      shapes.push({type:'line', x0:yr, x1:yr, y0:range[0], y1:range[1], line:{color:'rgba(31,119,180,.35)', width:2, dash:'dash'}});
      ann.push({x:yr, y:range[1], text:String(yr), yanchor:'top', showarrow:false, font:{size:10, color:'rgba(31,119,180,.65)'}});
    });
    return {margin:{l:50,r:6,t:8,b:28},xaxis:{title:"Year", range:[2014,2050]},yaxis:{title:"People", range},showlegend:true,shapes,annotations:ann};
  }
  function layoutT(range){
    return {margin:{l:50,r:6,t:8,b:28},xaxis:{title:"Year", range:[2014,2050]},yaxis:{title:"Trolleys (Cubicles)", range},showlegend:true};
  }

  // Animation state
  let n=2, timer=null;
  function slice(arr){ return arr.slice(0, n); }

  // Build initial series
  let P = readParams();
  let ED_all = simulateModel(P, P.mode);
  let ED_lin_all = simulateModel(P, "linear");
  let ED_log_all = simulateModel(P, "logistic");
  let admissions_all = computeAdmissions(ED_all, P);
  let T_noLOS_all  = computeTrolleysNoLOS(P, ED_all);
  let T_withLOS_all = computeTrolleys(P, ED_all);
  let CUB_all = computeCubicleCapacity(P);
  let TOT_all = computeTotalCapacity(P, CUB_all);

  // Historic overlay uses your table numbers
  const histX = YEARS_HIST.slice();
  const histY = HIST_ED.slice();

  function tracesED(){
    const kYears = findKYearsLimited(ED_all, P.K, P.kCount);
    const yE = yRangeFrom(histY.concat(ED_all, ED_lin_all, ED_log_all, admissions_all));
    const traces = [
      {name:"Historic (UHL ED attendees, 2014–2024)", x:histX, y:histY, mode:"lines", line:{color:"#d62728", width:2}},
      {name:"ED Attendees (selected)", x:YEARS_ALL.slice(0,n), y:slice(ED_all), mode:"lines", line:{color:"#1f77b4", width:3}},
      {name:"Admissions (= ED × rate)", x:YEARS_ALL.slice(0,n), y:slice(admissions_all), mode:"lines", line:{color:"#ff7f0e", width:2, dash:"dot"}}
    ];
    if(P.showAlt){
      traces.push({name:"ED Linear (overlay)", x:YEARS_ALL.slice(0,n), y:slice(ED_lin_all), mode:"lines", line:{color:"rgba(0,0,0,.5)", width:2, dash:"dash"}});
      traces.push({name:"ED Logistic (overlay)", x:YEARS_ALL.slice(0,n), y:slice(ED_log_all), mode:"lines", line:{color:"rgba(100,100,255,.6)", width:2, dash:"dash"}});
    }
    return {traces, layout: layoutED(yE, kYears)};
  }
  function tracesT(){
    const yT = yRangeFrom(T_withLOS_all.concat(T_noLOS_all, CUB_all, TOT_all));
    const demandNoLOS = slice(T_noLOS_all);
    const demandLOS = slice(T_withLOS_all);
    const CUB = slice(CUB_all);
    const TOT = slice(TOT_all);
    const gapBeyondSurge = demandLOS.map((v,i) => Math.max(0, v - TOT[i]));
    const traces = [
      {name:"Trolleys required (LOS-adjusted)", x:YEARS_ALL.slice(0,n), y:demandLOS, mode:"lines", line:{color:"#2ca02c", width:3}},
      {name:"Trolleys required (no LOS)", x:YEARS_ALL.slice(0,n), y:demandNoLOS, mode:"lines", line:{color:"rgba(44,160,44,.5)", width:2, dash:"dot"}},
      {name:"Capacity (cubicles)", x:YEARS_ALL.slice(0,n), y:CUB, mode:"lines", line:{color:"#666", width:2}},
      {name:"Capacity incl. surge", x:YEARS_ALL.slice(0,n), y:TOT, mode:"lines", line:{color:"purple", width:2, dash:"dash"}},
      {name:"Demand over surge capacity", x:YEARS_ALL.slice(0,n), y:gapBeyondSurge, mode:"lines", fill:"tozeroy", line:{color:"rgba(214,39,40,0.0)"}, fillcolor:"rgba(214,39,40,0.30)"}
    ];
    return {traces, layout: layoutT(yT)};
  }

  function render(){
    document.getElementById("yearLabel").textContent = "Year: " + YEARS_ALL[Math.min(n-1, YEARS_ALL.length-1)];
    let edT = tracesED(); Plotly.react("edPlot", edT.traces, edT.layout);
    let trT = tracesT(); Plotly.react("trolleyPlot", trT.traces, trT.layout);
  }
  function run(){
    btnRun.disabled=true; btnPause.disabled=false;
    if(timer) clearInterval(timer);
    timer = setInterval(()=>{ n+=1; if(n>YEARS_ALL.length){ pause(); return;} render(); },100);
  }
  function pause(){ btnRun.disabled=false; btnPause.disabled=true; if(timer){ clearInterval(timer); timer=null; } }
  function reset(){
    pause(); showVals();
    const p = readParams(); P = p;
    ED_all = simulateModel(P, P.mode);
    ED_lin_all = simulateModel(P, "linear");
    ED_log_all = simulateModel(P, "logistic");
    admissions_all = computeAdmissions(ED_all, P);
    T_noLOS_all  = computeTrolleysNoLOS(P, ED_all);
    T_withLOS_all = computeTrolleys(P, ED_all);
    CUB_all = computeCubicleCapacity(P);
    TOT_all = computeTotalCapacity(P, CUB_all);
    n=2; render();
  }

  ["input","change"].forEach(evt => {
    [growth,pop,seasonU,seasonM,initial,conv,present,los,applyLOS,capK,kCount,capBase2017,capInc,surge,growthStyle,showAlt,shockStart,shockDur,shockU,shockLOS].forEach(el => el.addEventListener(evt, reset));
  });
  btnRun.addEventListener("click", run);
  btnPause.addEventListener("click", pause);
  btnReset.addEventListener("click", reset);

  render();
})();
</script>
</body>
</html>
"""
path = "/mnt/data/uhl-ed-dashboard-datafit-clean-klines.html"
with open(path, "w", encoding="utf-8") as f:
    f.write(html_datafit)
path
