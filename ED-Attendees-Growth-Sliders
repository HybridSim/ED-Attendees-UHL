          <div class="small">Default is <strong>Exponential</strong> (fits 2014–2024 ~4.6% CAGR; robust near‑term).</div>
          <div style="margin-top:4px;">
            <input id="showAlt" type="checkbox"> <label for="showAlt" class="small">Overlay Linear & Logistic</label>
          </div>
        </div>

        <div class="control">
          <label>ED CAGR</label>
          <input id="growth" type="range" min="0.00" max="0.20" step="0.0005" value="0.046">
          <div class="val"><span id="growthVal">4.60%</span> / yr</div>
        </div>
        <div class="control">
          <label>Population growth</label>
          <input id="pop" type="range" min="0.00" max="0.03" step="0.0005" value="0.006">
          <div class="val"><span id="popVal">0.60%</span> / yr</div>
        </div>
        <div class="control">
          <label>Seasonal uplift (%)</label>
          <input id="seasonU" type="range" min="0.00" max="0.30" step="0.005" value="0.10">
          <div class="val"><span id="seasonUVal">10.0%</span> × <span id="seasonMVal">3</span> months</div>
          <input id="seasonM" type="range" min="0" max="6" step="1" value="3">
